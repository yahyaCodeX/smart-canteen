# Smart Canteen Environment Configuration
# Copy this file to .env and fill in your Neon PostgreSQL connection string

# ─────────────────────────────────────────────────────────────────────
# DATABASE — Neon PostgreSQL Free Tier
# Get yours at: https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
# ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://your_user:your_password@your-neon-host.neon.tech/hackathon_db?sslmode=require

# ─────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────
JWT_SECRET=smart_canteen_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
